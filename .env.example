# Linq — Partner API token and the signing secret of the webhook that points at
# this deployment's /eve/v1/linq route. Both from https://zero.linqapp.com
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=

# Agentcard — organization client credentials from https://app.agentcard.sh
# Sandbox credentials run the real Purchase API loop against real merchants;
# only the final confirm is declined (sandbox_mode). Start there.
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=
# sandbox (default) or production. In sandbox the connect code is always 111111.
AGENTCARD_MODE=sandbox
# AGENTCARD_API_URL=https://api.agentcard.sh

# Optional: the Linq number the agent texts from. Defaults to the first number on the account.
# LINQ_PHONE_NUMBER=+15551234567

# Agentcard webhook — signing secret returned once by POST /api/v2/webhook_endpoints
# for the endpoint https://<your-deployment>/agentcard/webhooks (events: vault.*).
AGENTCARD_WEBHOOK_SECRET=

# Upstash Redis — remembers which conversation sent each Vault link so the
# webhook can reply there. "Upstash for Redis" from the Vercel Marketplace sets
# these on the project automatically; `vercel env pull` copies them here.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: a key prefix, so several agents can share one Redis database.
# STORE_PREFIX=purchase

# Optional: the Agentcard iMessage app (apps/agentcard-imessage). With both set,
# Vault links and approvals go out as native Agentcard bubbles (imessage_app
# parts) with the passkey served inside Messages; without them, as link parts
# that open Safari.
# AGENTCARD_IMESSAGE_TEAM_ID=
# AGENTCARD_IMESSAGE_BUNDLE_ID=sh.agentcard.messages
# AGENTCARD_IMESSAGE_APP_STORE_ID=
